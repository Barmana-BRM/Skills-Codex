        <mxCell id="i65__r0__c2" value="Source" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontStyle=1;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r0" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="36" as="geometry">
            <mxRectangle width="230" height="36" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r0__c3" value="Interfaces (mnemonics)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontStyle=1;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r0" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="36" as="geometry">
            <mxRectangle width="360" height="36" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r1" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__t" vlsit_native_table="1">
          <mxGeometry y="76" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i65__r1__c0" value="TOP (can_top) frame" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r1" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r1__c1" value="Top level of a CAN protocol controller for microcontroller-style hosts. It joins the host bus to an internal register file, a bit-timing generator and a frame-processing engine, and exposes the serial CAN receive and transmit lines, an interrupt output, a bus-off status output and a programmable clock output. In this configuration the host uses a multiplexed address/data bus with separate address-latch, read and write strobes and a chip-select input." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r1" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r1__c2" value="can_top.v:214-874" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r1" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r1__c3" value="HOST, rx_i, tx_o, bus_off_on, irq_on, clkout_o, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r1" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="80" as="geometry">
            <mxRectangle width="360" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__t" vlsit_native_table="1">
          <mxGeometry y="156" width="2400" height="124" as="geometry" />
        </mxCell>
        <mxCell id="i65__r2__c0" value="i_can_registers (can_registers)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r2" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="124" as="geometry">
            <mxRectangle width="330" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r2__c1" value="Register file seen by the host. It stores the operating mode (basic or extended), command requests, interrupt enables, bit-timing parameters, the error-warning limit, the acceptance code and mask used for message filtering, a 13-byte transmit buffer and the clock-divider setting. It decodes host reads and writes and applies mode-dependent access rules (many registers can be written only while the controller is in reset mode), builds the status word from the reports of the frame-processing engine, collects seven interrupt sources into one latched, read-to-clear, active-low interrupt request, selects the register value returned on a read, and derives a programmable divided output clock. Its own logic is not expanded at this level." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r2" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="124" as="geometry">
            <mxRectangle width="1480" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r2__c2" value="can_registers.v:444-1251" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r2" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="124" as="geometry">
            <mxRectangle width="230" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r2__c3" value="HRA, RRD, CSI, BTI, irq_on, CLK, clkout_o" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r2" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="124" as="geometry">
            <mxRectangle width="360" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r3" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__t" vlsit_native_table="1">
          <mxGeometry y="280" width="2400" height="124" as="geometry" />
        </mxCell>
        <mxCell id="i65__r3__c0" value="i_can_btl (can_btl)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r3" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="124" as="geometry">
            <mxRectangle width="330" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r3__c1" value="Bit-timing generator. It derives the time quantum from the programmed prescaler, divides every bit into a synchronization segment, a first phase segment (including the propagation segment) and a second phase segment, performs hard synchronization on the start-of-frame edge and resynchronization on later edges within the programmed jump width, and can take three samples per bit and apply a majority vote. It produces the sample instant used by the receiver and the transmit instant used to drive the bus, and restricts synchronization while the node is transmitting. Its own logic is not expanded at this level." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r3" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="124" as="geometry">
            <mxRectangle width="1480" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r3__c2" value="can_btl.v:257-445" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r3" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="124" as="geometry">
            <mxRectangle width="230" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r3__c3" value="BTI, BSI, rx_sync, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r3" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="124" as="geometry">
            <mxRectangle width="360" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r4" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__t" vlsit_native_table="1">
          <mxGeometry y="404" width="2400" height="124" as="geometry" />
        </mxCell>
        <mxCell id="i65__r4__c0" value="i_can_bsp (can_bsp)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r4" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="124" as="geometry">
            <mxRectangle width="330" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r4__c1" value="Frame-processing engine. On reception it decodes identifier, control, data, CRC, acknowledge and end-of-frame fields with bit de-stuffing and CRC checking, filters accepted identifiers with an acceptance filter and stores accepted messages in a receive FIFO. On transmission it serializes the transmit buffer with bit stuffing, arbitrates against other nodes and handles the acknowledge slot. It detects bit, stuff, form, CRC and acknowledge errors, generates error and overload frames, and maintains transmit and receive error counters with the error-active, error-passive and bus-off states. It reports status, errors and events to the register file. Its own logic and children (CRC, acceptance filter, FIFO) are not expanded at this level." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r4" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="124" as="geometry">
            <mxRectangle width="1480" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r4__c2" value="can_bsp.v:699-2127" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r4" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="124" as="geometry">
            <mxRectangle width="230" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r4__c3" value="FAC, FRI, CSI, BSI, bus_off_on, tx_o, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r4" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="124" as="geometry">
            <mxRectangle width="360" height="124" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r5" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__t" vlsit_native_table="1">
          <mxGeometry y="528" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i65__r5__c0" value="Host bus adapter (FG of can_top)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r5" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r5__c1" value="Converts the multiplexed host bus into single-clock accesses. It captures the address presented on the shared lines while the address-latch strobe is active, detects the active edge of the write or read strobe to form one access pulse qualified by the chip-select input, passes the latched address and write data to the register file and the receive FIFO, and drives the read data onto the shared data lines only while a read is requested." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r5" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r5__c2" value="can_top.v:836-869" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r5" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r5__c3" value="HRA, HRS, FAC, HOST, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r5" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="80" as="geometry">
            <mxRectangle width="360" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r6" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__t" vlsit_native_table="1">
          <mxGeometry y="608" width="2400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i65__r6__c0" value="Read-data select (FG of can_top)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r6" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="80" as="geometry">
            <mxRectangle width="330" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r6__c1" value="Read-path multiplexer. From the latched address and the operating mode it decides whether a host read targets the received-message window or an ordinary register, selects the corresponding data source, and keeps the selected byte in an output register so that the host sees stable data until the next read." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r6" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="80" as="geometry">
            <mxRectangle width="1480" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r6__c2" value="can_top.v:743-762" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r6" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="80" as="geometry">
            <mxRectangle width="230" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r6__c3" value="HRS, RRD, FRI, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r6" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="80" as="geometry">
            <mxRectangle width="360" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r7" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__t" vlsit_native_table="1">
          <mxGeometry y="688" width="2400" height="58" as="geometry" />
        </mxCell>
        <mxCell id="i65__r7__c0" value="RX synchronizer (FG of can_top)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r7" vlsit_native_table="1">
          <mxGeometry x="0" width="330" height="58" as="geometry">
            <mxRectangle width="330" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r7__c1" value="Receive-line synchronizer. It passes the asynchronous CAN receive input through two flip-flops clocked by the core clock to remove metastability before the bit-timing generator uses it, and is initialised to the recessive (idle) level during reset." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r7" vlsit_native_table="1">
          <mxGeometry x="330" width="1480" height="58" as="geometry">
            <mxRectangle width="1480" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r7__c2" value="can_top.v:766-778" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r7" vlsit_native_table="1">
          <mxGeometry x="1810" width="230" height="58" as="geometry">
            <mxRectangle width="230" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i65__r7__c3" value="rx_sync, rx_i, CLK" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" vertex="1" parent="i65__r7" vlsit_native_table="1">
          <mxGeometry x="2040" width="360" height="58" as="geometry">
