# Local source books and parsed chapters are user-provided rights-sensitive inputs.
source/*
!source/.gitkeep
!source/chapters/
source/chapters/*
!source/chapters/.gitkeep

# Production outputs are usually derivative works. Keep them local by default.
chapters/*
!chapters/.gitkeep
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep

# Visual bibles often contain generated character/setting references tied to a source.
visual-bible/*
!visual-bible/.gitkeep
!visual-bible/style-samples/
visual-bible/style-samples/*
!visual-bible/style-samples/.gitkeep
!visual-bible/characters/
visual-bible/characters/*
!visual-bible/characters/.gitkeep
!visual-bible/settings/
visual-bible/settings/*
!visual-bible/settings/.gitkeep

